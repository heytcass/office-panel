# office-panel — ESPHome secrets template
# Copy to esphome/secrets.yaml and fill in real values.
# secrets.yaml is gitignored and must not be committed.

wifi_ssid: "YourIoTSSID"
wifi_password: "YourIoTPassword"

# Generate with: openssl rand -base64 32
api_encryption_key: "your-32-char-base64-api-key"

# OTA password used by the HA ESPHome app to push updates.
ota_password: "your-ota-password"

# Fallback access point password (used if Wi-Fi connect fails).
ap_password: "your-fallback-ap-password"
